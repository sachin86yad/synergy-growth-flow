# XYZ SERVICES — server-side environment variables.
# Copy to .env and fill in. Never commit real credentials.
# Database credentials for the managed backend are injected automatically.

# Optional automation hand-off. If unset, enquiries are still saved.
N8N_WEBHOOK_URL=

# Chatbot providers (server-side only — never expose in the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email notifications (foundation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Placeholder guard for GET /api/contact. Replace with real admin auth before production.
ADMIN_API_TOKEN=

# Public site origin, used for canonical URLs and CORS allow-lists
FRONTEND_URL=
